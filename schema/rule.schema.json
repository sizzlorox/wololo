{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "wololo rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "files", "why", "fix"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "kind": { "type": "string", "enum": ["forbid", "require", "max-lines", "forbid-path", "require-sibling", "tautological-tests"] },
    "severity": { "type": "string", "enum": ["error", "warn"] },
    "files": { "type": "array", "items": { "type": "string" } },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "pattern": { "type": "string", "description": "Regex for forbid/require." },
    "flags": { "type": "string" },
    "max": { "type": "number", "description": "Line budget for max-lines." },
    "sibling": { "type": "string", "description": "Template for require-sibling, e.g. \"{dir}/{name}.test{ext}\"." },
    "why": { "type": "string", "description": "The mistake that made this rule necessary." },
    "fix": { "type": "string", "description": "What the agent should do instead. Shown at the moment of violation." },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bad": { "type": "array", "items": { "type": "object", "required": ["path", "content"], "properties": { "path": { "type": "string" }, "content": { "type": "string" }, "repeat": { "type": "integer", "minimum": 1, "description": "Repeat content N times (for size rules)." } } } },
        "good": { "type": "array", "items": { "type": "object", "required": ["path", "content"], "properties": { "path": { "type": "string" }, "content": { "type": "string" }, "repeat": { "type": "integer", "minimum": 1, "description": "Repeat content N times (for size rules)." } } } }
      }
    }
  }
}
