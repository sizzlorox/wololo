{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node bin/wololo.js hook copilot session-start",
        "powershell": "node bin/wololo.js hook copilot session-start",
        "cwd": ".",
        "timeoutSec": 120
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node bin/wololo.js hook copilot post-edit",
        "powershell": "node bin/wololo.js hook copilot post-edit",
        "cwd": ".",
        "timeoutSec": 120
      }
    ]
  }
}
