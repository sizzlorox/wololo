{
  "$schema": "../../node_modules/wololo/schema/rule.schema.json",
  "id": "no-secrets",
  "kind": "forbid",
  "severity": "error",
  "files": ["**/*.{js,mjs,cjs,ts,tsx,jsx,json,md,yml,yaml,toml,sh,ps1,py,rs,go,txt}"],
  "exclude": ["**/package-lock.json", "**/node_modules/**"],
  "pattern": "Bearer\\s+[A-Za-z0-9._~+/-]{16,}|\\b(sk|pk|rk)-[A-Za-z0-9_-]{16,}|\\bgh[pousr]_[A-Za-z0-9]{30,}|\\bxox[abprs]-[A-Za-z0-9-]{10,}|\\bAIza[0-9A-Za-z_-]{30,}|\\bAKIA[0-9A-Z]{16}\\b|-----BEGIN [A-Z ]*PRIVATE KEY-----",
  "why": "A real API key was pasted into a test as sample data and committed; it had to be purged from history.",
  "fix": "Never commit credentials. Use an environment variable, or an obviously fake value. A file that needs fake tokens on purpose (e.g. tests of a secret detector) declares it: wololo-ignore-file no-secrets: <why>.",
  "examples": {
    "bad": [{ "path": "test/a.test.js", "content": "const h = 'Authorization: Bearer abcdef0123456789abcdef';\n" }],
    "good": [{ "path": "test/a.test.js", "content": "const h = `Authorization: Bearer ${process.env.API_TOKEN}`;\n" }]
  }
}
